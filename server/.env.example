# ============================
# UtopiaHire Server - Environment Variables
# ============================
# Copy this file to .env and fill in required values
# cp server/.env.example .env

# MongoDB connection string (required)
MONGODB_URI=mongodb://localhost:27017/utopiahire

# JWT secret: at least 16 random characters (required)
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_min_16_chars_dev

# OpenAI API key (required for CV processing)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Server
PORT=4000
HOST=0.0.0.0

# Environment: production | development | test
# NODE_ENV=development

# CORS origins (comma-separated, or omit for permissive dev)
# CORS_ORIGIN=http://localhost:5173

# Stripe (required for billing)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_1234abcd5678ef

# Resend (required for email)
# RESEND_API_KEY=re_... 
# FROM_EMAIL=UtopiaHire <noreply@yourdomain.com>

# Frontend URL (for email links, Stripe redirects)
FRONTEND_URL=http://localhost:5173

# Admin bootstrap: elevate a user to super_admin on startup
# BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com

# LinkedIn automation (required for the LinkedIn dashboard)
# Create an app at https://www.linkedin.com/developers/ and request the
# w_member_social scope (self-serve). Scopes requested: openid profile email w_member_social.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://localhost:4000/linkedin/oauth/callback
# LINKEDIN_API_VERSION=202605
# Daily auto-post cron (default: every day at 09:00 server time)
# LINKEDIN_POST_TIME=0 9 * * *
# How often (minutes) to sweep published posts for new comments. Default 30.
# LINKEDIN_COMMENT_SWEEP_MINUTES=30
# Optional override for the content knowledge graph path (defaults to ../content/graphify-out)
# CONTENT_GRAPH_PATH=
