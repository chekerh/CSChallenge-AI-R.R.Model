# MongoDB (required)
MONGODB_URI=mongodb://localhost:27017/utopiahire

# Auth: use at least 16 random characters in production
JWT_SECRET=change_me_min_16_chars_dev

# OpenAI (required for resume processing)
OPENAI_API_KEY=
# Optional override (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Server bind
PORT=4000
HOST=0.0.0.0

# Production
# NODE_ENV=production

# CORS: comma-separated origins, or omit for permissive dev behavior
# CORS_ORIGIN=https://app.example.com,https://www.example.com

# Optional: Kaggle proxy (/kaggle/datasets)
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Optional: Google OAuth (not wired in current routes)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK=http://localhost:4000/auth/google/callback
